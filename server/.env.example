# Copy to .env and fill in. NEVER commit .env.
# Server listen port (default 8920; 8001 is taken by SillyTavern on this device)
PORT=8920

# OpenAI-compatible provider (chat completions). Override the base URL for
# local/proxy endpoints (SillyTavern, openai-compatible gateways, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic provider
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
